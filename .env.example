BOT_TOKEN=
ARKESEL_API_KEY=
PAYSTACK_SECRET_KEY=
DEVELOPER_CHAT_ID=
DEVELOPER_USER_ID=
SENDER_ID_APPROVER_USER_IDS=
GENERIC_SENDER_ID=TXTORA

# Optional defaults
CUSTOM_SENDER_ID_FEE_GHS=8
COST_PER_SMS=0.0276
SELLING_PRICE_PER_SMS=0.05
WEBHOOK_PORT=3000
WEB_PORT=4000
JWT_SECRET=
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/textora?retryWrites=true&w=majority
PAYSTACK_CALLBACK_URL=

# Resend Email Configuration (for password reset)
RESEND_API_KEY=
EMAIL_FROM="Textora <onboarding@resend.dev>"
APP_URL=https://textora-bms-website.onrender.com

# KebSEND Email (customer email). Keep this a SEPARATE Resend account/key from
# RESEND_API_KEY above, so customer sending can never affect password-reset mail.
# Leave EMAIL_RESEND_API_KEY empty to use the mock provider locally.
EMAIL_PROVIDER=
EMAIL_RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_SHARED_DOMAIN=mail.kebsend.com
EMAIL_CREDITS_PER_RECIPIENT=0.2
EMAIL_MAX_RECIPIENTS=50
EMAIL_DAILY_CAP_UNPAID=100
EMAIL_MAX_DOMAINS_PER_ACCOUNT=3
EMAIL_CONTENT_RETENTION_DAYS=30
