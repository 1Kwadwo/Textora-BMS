{
  "name": "kebsend-web",
  "version": "1.0.0",
  "description": "KebSEND BMS All-in-One Web Platform, Database & Developer Hub",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:css": "tailwindcss -c tailwind.config.js -i styles/input.css -o public/style.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i styles/input.css -o public/style.css --watch"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "daisyui": "^4.12.10",
    "tailwindcss": "^3.4.17"
  }
}
