# KebSEND settings for the AWS server. Copy each value from Render
# (Dashboard > your service > Environment). Both Render services (the website
# and the bot) now share this ONE file, so merge their values here.
# PORT, WEBHOOK_PORT and BOT_WEBHOOK_URL are set by PM2; leave them out.

# Bot
BOT_TOKEN=
ARKESEL_API_KEY=
PAYSTACK_SECRET_KEY=
DEVELOPER_CHAT_ID=
DEVELOPER_USER_ID=
SENDER_ID_APPROVER_USER_IDS=
GENERIC_SENDER_ID=
GENERIC_SENDER_ALLOWED_EMAILS=

# Database and login
MONGODB_URI=
# Use the SAME value as Render or every user gets logged out. 16+ characters.
JWT_SECRET=

# Public addresses (new domain, no more onrender.com)
PUBLIC_BASE_URL=https://kebsend.com
APP_URL=https://kebsend.com
PAYSTACK_CALLBACK_URL=
CORS_ALLOWED_ORIGINS=

# Password reset email
RESEND_API_KEY=
EMAIL_FROM=

# KebSEND Email (leave EMAIL_RESEND_API_KEY empty to keep it switched off)
EMAIL_RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_SHARED_DOMAIN=

# Add any other variable you had on Render below this line, as NAME=value
